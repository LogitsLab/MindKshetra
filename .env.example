# MindKshetra environment template
# Copy to .env.local (preferred) or .env and fill values:
#   cp .env.example .env.local
#
# Tiers (also tabled in ARCHITECTURE.md §12):
#   core     — NO env needed: all 701 verses ship in the repo (CONTENT_SOURCE
#              defaults to json) and everything account-shaped runs in guest
#              mode. A fresh clone with an empty .env.local browses fine.
#   AI       — GROQ_API_KEY: Madhav chat, verse stories, chart readings.
#   accounts — Supabase: auth, favorites, journal, progress, community.
#              Routes that need it answer 503 with a pointer here when unset.
#   email    — Resend: Verse-of-the-Day email.
#   ops      — CRON_SECRET, MAINTAINER_USER_IDS, community kill switches.

# =============================================================================
# AI — Madhav chat + verse stories + astrology readings
# =============================================================================

# Groq API key — get one at https://console.groq.com
GROQ_API_KEY=

# Optional model overrides
# GROQ_MODEL=qwen/qwen3.6-27b                      # Madhav streaming chat
# GROQ_PREDICTIONS_MODEL=openai/gpt-oss-120b       # one-shot chart readings (cached)
# GROQ_PREDICTIONS_REASONING_EFFORT=medium

# =============================================================================
# ACCOUNTS — Supabase (auth, user data, community, chat persistence)
# Create a project at https://supabase.com. Without these, account routes
# return 503 "Supabase is not configured on this deployment" and the rest of
# the site runs in guest mode.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server-only writes (moderation queue, push tokens, events)
# and seed/migrate scripts; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Content source: json (default, verses from the repo) or db (requires
# Supabase + `npm run db:migrate -- <project-ref>` + npm run db:seed)
# CONTENT_SOURCE=db

# =============================================================================
# EMAIL — Verse of the Day (Resend)
# 1. Create an account at https://resend.com → API Keys → create key
# 2. For local testing, Resend allows sending only to your signup email
#    with from: MindKshetra <onboarding@resend.dev>
# 3. For production: Domains → add + verify your domain, then set RESEND_FROM
# 4. Apply supabase/migrations/004_user_prefs.sql (user email opt-out)
# 5. Restart the app. Account → Settings → toggle + “Email today’s verse”
# =============================================================================

RESEND_API_KEY=
RESEND_FROM=MindKshetra <noreply@mind.logitslab.com>

# =============================================================================
# OPS — cron auth, maintainer allowlist, incident kill switches
# =============================================================================

# Bearer token for /api/cron/* (VOTD broadcast, push dispatch).
# Generate: openssl rand -hex 32
CRON_SECRET=

# Comma-separated Supabase auth user ids allowed into /api/admin/moderation.
# Empty means nobody — the admin surface fails closed.
MAINTAINER_USER_IDS=

# Community kill switches (lib/kill-switch.ts). Set to 0/false/off/no to
# PAUSE the surface; unset or any other value leaves it LIVE.
# On Preview/dev and production until G1+G3 pass, keep these OFF:
COMMUNITY_REFLECTIONS_ENABLED=false
COMMUNITY_REPORTS_ENABLED=false

# =============================================================================
# OPTIONAL — infrastructure & tuning
# =============================================================================

# Public site URL (metadata / Open Graph / share + email links). Defaults to
# the production origin when unset.
# Local web dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://mind.logitslab.com

# Upstash Redis — shared rate limits + story/incognito-chart cache across
# serverless instances. Create at https://console.upstash.com → REST API.
# Without these, each instance uses in-memory fallback (fine for local dev).
# Verify after deploy: GET /api/health → redis.reachable should be true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Voyage — hybrid vector retrieval for Madhav (v2.1+; needs CONTENT_SOURCE=db
# + seeded embeddings). Falls back to tag-only retrieval when unset.
# Get a key at https://www.voyageai.com
VOYAGE_API_KEY=

# Nominatim User-Agent for birth-place geocoding (OpenStreetMap policy)
# NOMINATIM_USER_AGENT=MindKshetra/1.0 (astrology; contact: you@example.com)

# Dev only: keep the verse-story cache in memory (skip .story-cache on disk)
# STORY_CACHE_MEMORY_ONLY=1

# =============================================================================
# OPTIONAL — public links (footer / support page; hidden when unset)
# =============================================================================

# NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
# NEXT_PUBLIC_TELEGRAM_URL=
# NEXT_PUBLIC_RAZORPAY_DONATION_URL=
# NEXT_PUBLIC_OPEN_COLLECTIVE_URL=
# NEXT_PUBLIC_GITHUB_SPONSORS_URL=
# Set the above on Vercel Preview (`dev`) first — see docs/nonprofit-kickoff.md.
# Until they are set, /support and /community stay honest-empty (no fake links).
# Prod stays unset until soak sign-off (docs/dev-soak.md).

# =============================================================================
# Scripts / CI only — never needed in .env.local for the app itself
# =============================================================================
# SUPABASE_ACCESS_TOKEN      npm run db:migrate auth (or `npx supabase login`)
# EVAL_HYBRID, EVAL_HYBRID_MIN_RATE, EVAL_HYBRID_MIN_EMBEDDINGS,
# EVAL_VOYAGE_DELAY_MS       scripts/eval-retrieve.cjs knobs
# EMBED_DELAY_MS             scripts/seed-embeddings.cjs throttle
# STORY_PREGEN_DELAY_MS      scripts/pregen-stories.cjs throttle
# SPIKE_VOYAGE_DELAY_MS      scripts/spike-chart-tags.cjs throttle
# GITHUB_BEFORE_SHA          scripts/bump-version-if-needed.mjs (CI-set)
# NODE_ENV, VERCEL           platform-set; never set these by hand
